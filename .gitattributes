# The regression development record hashes its own source, protocol and table files
# (SHA-256 in versions/*/outputs/*.json). Check them out byte-for-byte with LF endings so
# the recorded digests also match on Windows clones with core.autocrlf=true.
notebooks/phase2/regression_dev/** text eol=lf
src/regression_dev/** text eol=lf
*.png binary
*.parquet binary
*.pdf binary
*.joblib binary

# Keep the nine course CSVs byte-identical to the fixed course ZIP, including
# original CRLF endings and comment whitespace. The regression audit checks raw
# SHA-256 fingerprints; source data is not subject to code whitespace cleanup.
/data/olist_*.csv -text whitespace=-blank-at-eol,cr-at-eol
/data/product_category_name_translation.csv -text whitespace=-blank-at-eol,cr-at-eol
