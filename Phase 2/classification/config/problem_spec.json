{
  "problem": "low_review_classification",
  "question": "Will an order receive a 1-2 star review?",
  "target": {
    "name": "is_low_review",
    "definition": "1 if review_score in {1, 2} else 0",
    "grain": "one row per order_id, one review per order (earliest kept)"
  },
  "cohort": "reviewed orders with at least one line item, delivered or not; purchase months 2016-09 to 2018-08",
  "prediction_point": {
    "name": "survey trigger T",
    "definition": "min(order_delivered_customer_date, order_estimated_delivery_date)",
    "rationale": "Olist emails the review survey when the order is delivered or the estimated date passes; every delivery feature is evaluated as of T"
  },
  "stakeholder": {
    "role": "Olist customer-experience / seller-quality team",
    "decision": "rank orders at T by low-review risk and route the top of the list to proactive outreach; aggregate by seller for quality reviews"
  },
  "protocol": {
    "source": "Phase 2/src/delivery_regression.py (shared with the regression problem)",
    "validation_start": "2018-03-01",
    "validation_end": "2018-04-01",
    "test_start": "2018-07-01",
    "windows": {
      "train": [
        "2016-09",
        "2018-02"
      ],
      "validation": [
        "2018-03",
        "2018-03"
      ],
      "maturation_gap": [
        "2018-04",
        "2018-06"
      ],
      "test": [
        "2018-07",
        "2018-08"
      ]
    },
    "label_known_column": "review_creation_date",
    "label_maturity": "train rows need the review written before validation_start; validation rows before test_start",
    "cv": {
      "kind": "expanding, label-matured",
      "cutoffs": [
        "2017-07-01",
        "2017-10-01",
        "2018-01-01",
        "2018-03-01"
      ]
    },
    "seed": 5006
  },
  "families": {
    "A_linear": [
      "LogisticRegression (balanced) baseline",
      "LogisticRegression C tuned"
    ],
    "B_tree": [
      "DecisionTreeClassifier (balanced) baseline",
      "RandomForestClassifier (balanced_subsample)",
      "CatBoostClassifier (auto_class_weights Balanced)"
    ],
    "C_ensemble": [
      "sklearn StackingClassifier check (baseline_variant_review)",
      "mean / convex / logistic stack on matured OOF probabilities (ensemble_comparison)"
    ]
  },
  "class_imbalance": {
    "positive_rate_train": 0.137,
    "strategy": "class weights, threshold tuned on validation to maximise F1 then frozen",
    "resampling": "SMOTE only as an appendix sensitivity row",
    "evidence": "class-balance study in ensemble_comparison"
  },
  "metrics": {
    "primary": "PR-AUC (average precision) on the test window, threshold-free",
    "secondary": [
      "ROC-AUC",
      "balanced accuracy",
      "Brier",
      "precision / recall / F1 at frozen threshold",
      "recall in top 10%"
    ],
    "baselines": [
      "majority class (PR-AUC = positive rate)",
      "rule: not delivered by T implies low review"
    ],
    "selection": "validation PR-AUC; ensemble retained only if >= 1% relative gain over best single model"
  },
  "success_criteria": {
    "pr_auc": "at least 2x the no-skill level",
    "operating_point": "recall >= 0.60 with precision >= 0.35 at the frozen threshold (set 6 Oct, before modelling)"
  },
  "excluded_inputs": [
    "delivery_days",
    "has_review_comment",
    "is_low_review",
    "is_on_time",
    "order_delivered_carrier_date",
    "order_delivered_customer_date",
    "order_status",
    "review_answer_timestamp",
    "review_creation_date",
    "review_score",
    "survey_trigger_time"
  ],
  "feature_groups": {
    "order": [
      "n_items",
      "n_distinct_products",
      "n_sellers",
      "total_price",
      "total_freight",
      "freight_ratio"
    ],
    "product": [
      "total_weight_g",
      "max_weight_g",
      "total_volume_cm3",
      "max_dimension_cm",
      "main_category",
      "n_categories"
    ],
    "geography": [
      "max_distance_km",
      "any_distance_missing",
      "same_state",
      "same_city",
      "customer_state",
      "seller_state",
      "customer_region",
      "seller_region",
      "customer_zip2"
    ],
    "timing": [
      "promised_days",
      "days_to_shipping_limit",
      "purchase_month_num",
      "purchase_dow",
      "purchase_hour",
      "is_weekend",
      "black_friday_week",
      "approval_lag_hours"
    ],
    "payment": [
      "main_payment_type",
      "payment_max_installments",
      "n_payment_methods",
      "payment_total"
    ],
    "seller_history": [
      "seller_prior_orders",
      "seller_tenure_days",
      "seller_prior_mean_delivery_days",
      "seller_prior_late_rate",
      "seller_prior_low_review_rate",
      "seller_id_enc"
    ],
    "route_history": [
      "route_prior_orders",
      "route_prior_mean_delivery_days",
      "route_prior_late_rate"
    ],
    "delivery_at_T": [
      "delivered_by_T",
      "delivery_days_at_T",
      "days_vs_promise_at_T",
      "carrier_shipped_by_T",
      "carrier_handover_days_at_T",
      "carrier_transit_days_at_T",
      "delivery_vs_seller_prior_at_T"
    ]
  },
  "test_scored": "once per final model inside each notebook"
}